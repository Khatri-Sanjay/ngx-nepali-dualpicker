{
    "name": "nepali-dualpicker-workspace",
    "version": "0.0.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve playground",
        "prestart:all": "npm run build:lib",
        "start:all": "node scripts/start-apps.mjs",
        "build": "npm run build:lib && npm run build:playground && npm run build:docs",
        "watch": "ng build ngx-nepali-dualpicker --watch --configuration development",
        "test": "ng test ngx-nepali-dualpicker --configuration ci",
        "test:playground": "ng test playground --watch=false --browsers=ChromeHeadless",
        "check:docs": "node scripts/check-doc-examples.mjs",
        "docs:api": "node scripts/generate-api-reference.mjs",
        "build:lib": "ng build ngx-nepali-dualpicker --configuration production",
        "build:playground": "ng build playground --configuration production",
        "pack:lib": "npm run build:lib && node scripts/pack-library.mjs",
        "release:check": "npm run check && npm test && npm run build && npm run test:playground && npm run test:docs && npm run check:docs && npm run check:calendar && npm run check:package && npm run check:bundle && npm run pack:lib",
        "test:compat": "node scripts/check-compatibility.mjs",
        "prepare": "husky",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "npm run lint -- --fix",
        "lint:staged": "lint-staged",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --project tsconfig.eslint.json --noEmit",
        "check": "npm run check:architecture && npm run lint && npm run format:check && npm run typecheck",
        "check:architecture": "node scripts/check-architecture.mjs",
        "check:package": "node scripts/check-package.mjs",
        "prestart": "npm run build:lib",
        "test:watch": "ng test ngx-nepali-dualpicker",
        "check:bundle": "node scripts/check-core-bundle.mjs",
        "start:playground": "ng serve playground --port 4200",
        "prestart:playground": "npm run build:lib",
        "start:docs": "ng serve documentation --port 4201",
        "prestart:docs": "npm run build:lib",
        "build:docs": "node scripts/build-documentation.mjs",
        "test:docs": "ng test documentation --watch=false --browsers=ChromeHeadless",
        "check:calendar": "node scripts/check-calendar.mjs",
        "docs:data": "node scripts/generate-doc-data.mjs",
        "docs:registry": "node scripts/refresh-doc-registry.mjs && npm run docs:data",
        "prebuild:docs": "npm run docs:api && npm run docs:data",
        "check:docs-site": "node scripts/check-doc-site.mjs",
        "check:docs-browser": "node scripts/check-doc-browser.mjs",
        "build:vercel": "node scripts/build-vercel.mjs",
        "check:vercel": "node scripts/check-vercel-output.mjs"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "~17.3.12",
        "@angular/compiler": "~17.3.12",
        "@angular/core": "~17.3.12",
        "@angular/forms": "~17.3.12",
        "@angular/platform-browser": "~17.3.12",
        "@angular/platform-server": "17.3.12",
        "@angular/router": "~17.3.12",
        "@angular/ssr": "17.3.17",
        "rxjs": "~7.8.0",
        "tslib": "^2.6.0",
        "zone.js": "~0.14.10"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "~17.3.17",
        "@angular-eslint/eslint-plugin": "^21.4.0",
        "@angular-eslint/eslint-plugin-template": "^21.4.0",
        "@angular-eslint/template-parser": "^21.4.0",
        "@angular/cli": "~17.3.17",
        "@angular/compiler-cli": "~17.3.12",
        "@angular/platform-browser-dynamic": "~17.3.12",
        "@eslint/js": "^10.0.1",
        "@types/jasmine": "~5.1.0",
        "axe-core": "^4.14.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "lint-staged": "^16.4.0",
        "ng-packagr": "~17.3.0",
        "prettier": "^3.9.9",
        "typescript": "~5.4.5",
        "typescript-eslint": "^8.71.0"
    },
    "engines": {
        "node": ">=20.19.0 <21 || >=24 <25",
        "npm": ">=10 <12"
    }
}
