{
    "useTabs": true,
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json", "*.yml", "*.yaml", "*.md"],
            "options": { "useTabs": false, "tabWidth": 4 }
        },
        {
            "files": ["apps/**/*.html", "libs/**/*.html"],
            "options": { "parser": "angular" }
        }
    ]
}
